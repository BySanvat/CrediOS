rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberPath(workspaceId, userId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId);
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && get(workspacePath(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId, request.auth.uid));
    }

    function createsOwnWorkspace(workspaceId) {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.defaultCurrency is string
        && request.resource.data.name is string;
    }

    function createsOwnerMembership(workspaceId, userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == "owner"
        && getAfter(workspacePath(workspaceId)).data.ownerId == request.auth.uid;
    }

    function workspaceScopedCreate(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && request.resource.data.workspaceId == workspaceId;
    }

    function workspaceScopedUpdate(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && resource.data.workspaceId == workspaceId
        && request.resource.data.workspaceId == workspaceId;
    }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid;
      allow read, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if createsOwnWorkspace(workspaceId);
      allow read: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if false;

      match /members/{userId} {
        allow create: if createsOwnerMembership(workspaceId, userId) || isWorkspaceOwner(workspaceId);
        allow read: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceOwner(workspaceId);
        allow delete: if false;
      }

      match /clients/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /simulations/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /creditAccounts/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;

        match /installments/{childId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create: if workspaceScopedCreate(workspaceId);
          allow update: if workspaceScopedUpdate(workspaceId);
          allow delete: if false;
        }

        match /payments/{childId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create: if workspaceScopedCreate(workspaceId)
            && request.resource.data.createdBy == request.auth.uid;
          allow update, delete: if false;
        }

        match /extraPayments/{childId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create: if workspaceScopedCreate(workspaceId)
            && request.resource.data.createdBy == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /personalCategories/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /personalTransactions/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if workspaceScopedUpdate(workspaceId)
          && resource.data.createdBy == request.auth.uid;
        allow delete: if false;
      }

      match /personalBudgets/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /recurringRules/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /personalDebts/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;

        match /movements/{childId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create: if workspaceScopedCreate(workspaceId)
            && request.resource.data.createdBy == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /reminders/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId);
        allow update: if workspaceScopedUpdate(workspaceId);
        allow delete: if false;
      }

      match /auditEvents/{documentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if workspaceScopedCreate(workspaceId)
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
